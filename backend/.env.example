SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL (local o Supabase). Deja estas vacías para usar SQLite en desarrollo.
POSTGRES_DB=
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

CORS_ALLOWED_ORIGINS=http://localhost:5173

# S3 storage para imágenes de producto (Supabase Storage u otro S3-compatible).
# Deja estas vacías para guardar archivos en disco local durante desarrollo.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=media
AWS_S3_ENDPOINT_URL=
AWS_S3_REGION_NAME=us-east-1
